# Configurazione per lo sviluppo in locale.
# Viene caricata SOLO da `npm run start:dev` (via dotenv-cli).
# `npm start` e `npm run build` la ignorano e usano .env (Railway).

# Backend locale
REACT_APP_API_BASE=http://localhost:3001

# Il backend è sulla 3001: il frontend gira sulla 3000
PORT=3000

# Non aprire il browser automaticamente
BROWSER=none

# Silenzia i warning "Failed to parse source map" di html5-qrcode
GENERATE_SOURCEMAP=false
